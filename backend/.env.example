# Konfigurasi Server LMS SMAN 2 Padalarang Backend
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Konfigurasi Database Supabase PostgreSQL
# Format connection string: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API Keys & Endpoints
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_PROJECT_REF=yourproject
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Keamanan JWT
JWT_SECRET=rahasia-lms-sman2-padalarang-access-token-key-2026
JWT_REFRESH_SECRET=rahasia-lms-sman2-padalarang-refresh-token-key-2026
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
